@model IzinTakipPaneli.Models.ViewModels.UserDashboardVm
@{
    Layout = null;
    ViewData["Title"] = "Kullanıcı Paneli";

    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
    var yearEndStr = new DateTime(DateTime.Today.Year, 12, 31).ToString("yyyy-MM-dd");
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
</head>
<body>

    <div class="header-blue py-3 px-4 d-flex justify-content-between align-items-center">
        <div class="fw-semibold">İzin Takip Paneli</div>
        <div>
            <span class="me-3">Hoşgeldiniz, <strong>@Model.Username</strong></span>
            <a class="btn btn-logout btn-sm" asp-controller="Login" asp-action="Logout">Çıkış Yap</a>
        </div>
    </div>

    <div class="container mt-4">

        @if (TempData["Error"] != null)
        {
                <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
                <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card-info">
                    <div class="small text-muted">Ad Soyad</div>
                    <div class="fw-semibold">@Model.FullName</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-info">
                    <div class="small text-muted">Departman</div>
                    <div class="fw-semibold">@Model.DepartmentName</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-info">
                    <div class="small text-muted">Yıllık İzin Limiti</div>
                    <div class="fw-semibold">@Model.MaxAnnualDays gün</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-6">
                <div class="card-info">
                    <div class="small text-muted">Kullanılan Yıllık İzin</div>
                    <div class="fw-semibold">@Model.UsedAnnualDays gün</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card-info">
                    <div class="small text-muted">Kalan Yıllık İzin</div>
                    <div class="fw-semibold">@Model.RemainingAnnualDays gün</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <h5 class="mb-0">İzin Geçmişim</h5>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#leaveModal">İzin Kullan</button>
        </div>

        <div class="table-responsive mt-2">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Tür</th>
                        <th>Başlangıç</th>
                        <th>Bitiş</th>
                        <th>İş Günü</th>
                        <th>Oluşturma</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Leaves.Any())
                    {
                        foreach (var l in Model.Leaves)
                        {
                                    <tr>
                                        <td>@l.LeaveType</td>
                                        <td>@l.StartDate.ToString("dd.MM.yyyy")</td>
                                        <td>@l.EndDate.ToString("dd.MM.yyyy")</td>
                                        <td>@l.TotalDays</td>
                                        <td>@l.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                        }
                    }
                    else
                    {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Henüz hiç izin kullanmadınız.</td>
                            </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="leaveModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header header-blue">
            <h5 class="modal-title">İzin Kullan</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
          </div>
          <div class="modal-body">
            <div class="mb-2"><div class="small text-muted">Ad Soyad</div><div class="fw-semibold">@Model.FullName</div></div>
            <div class="mb-2"><div class="small text-muted">Departman</div><div class="fw-semibold">@Model.DepartmentName</div></div>
            <div class="mb-3"><div class="small text-muted">Kalan Yıllık İzin</div><div class="fw-semibold">@Model.RemainingAnnualDays gün</div></div>

            <form id="leaveForm" method="post" asp-action="RequestLeave" asp-controller="Users">
                        @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">İzin Türü</label>
                    <select class="form-select" name="leaveTypeId" id="leaveTypeId" required>
                        <!-- Yer tutucu, seçilmeden submit edilemez -->
                        <option value="" selected disabled>Seçiniz..</option>
                                @foreach (var t in Model.LeaveTypes)
                                {
                                <option value="@t.Value">@t.Text</option>
                                }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Başlangıç Tarihi</label>
                    <!-- min bugün, max yıl sonu -->
                    <input class="form-control" type="date" name="startDate" id="startDate"min="@todayStr" max="@yearEndStr" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Bitiş Tarihi</label>
                    <!-- min bugün, max yıl sonu (start seçilince JS ile min=start) -->
                    <input class="form-control" type="date" name="endDate" id="endDate"min="@todayStr" max="@yearEndStr" required />
                </div>

                <div id="validationMsg" class="mb-2 small"></div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary" id="submitBtn" disabled>Onayla ve Kaydet</button>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {

            const start = document.getElementById('startDate');   
            const end = document.getElementById('endDate');     
            const typeSel = document.getElementById('leaveTypeId'); 
            const msg = document.getElementById('validationMsg');
            const submitBtn = document.getElementById('submitBtn');
            const form = document.getElementById('leaveForm');
            const modalEl = document.getElementById('leaveModal');
            const todayStr = '@todayStr'; // “yyyy-MM-dd”

            /* Anti-Forgery (CSRF) token’ı çek */
            function getAntiForgery () {
                const el = document.querySelector('input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            }

            /* Modal formunu ilk hâline döndür */
            function resetModalForm () {
                form.reset(); // tüm alanları temizle
                if (typeSel.options.length && typeSel.options[0].value === '') {
                    typeSel.selectedIndex = 0; // placeholder seçimi koru
                }
                end.min = todayStr; // bitiş min -> bugün
                msg.className = 'mb-2 small'; // mesaj ve buton sıfırla
                msg.innerText = '';
                submitBtn.disabled = true;
            }

            /* Sunucu tarafı tarih & limit doğrulaması */
            async function validate () {

                submitBtn.disabled = true;
                msg.className = 'mb-2 small text-muted';
                msg.innerText = 'Kontrol ediliyor…';

                const s = start.value, e = end.value, t = typeSel.value;
                if (!s || !e || !t) { msg.innerText = ''; return; }

                try {
                    const res = await fetch('@Url.Action("ValidateLeaveRange", "Users")', {
                        method:  'POST',
                        headers: { 'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8' },
                        body:
                          `__RequestVerificationToken=${encodeURIComponent(getAntiForgery())}` +
                          `&startDate=${encodeURIComponent(s)}` +
                          `&endDate=${encodeURIComponent(e)}` +
                          `&leaveTypeId=${encodeURIComponent(t)}`
                    });
                    const data = await res.json();

                    if (data.ok) {         
                        msg.className = 'mb-2 small text-success';
                        msg.innerText = data.message;
                        submitBtn.disabled = false;
                    } else {                   
                        msg.className = 'mb-2 small text-danger';
                        msg.innerText = data.message;
                    }

                } catch {
                    msg.className = 'mb-2 small text-danger';
                    msg.innerText = 'Doğrulama sırasında hata oluştu.';
                }
            } 

            // Tür veya tarihler değiştiğinde doğrula
            typeSel.addEventListener('change', validate);
            start   .addEventListener('change', validate);
            end     .addEventListener('change', validate);

            // start değişince end.min güncellenir
            start.addEventListener('change', () => {
                if (start.value) {
                    end.min = start.value;
                    // end, start’tan küçükse temizle
                    if (end.value && end.value < start.value) {
                        end.value = '';
                        msg.innerText = '';
                        submitBtn.disabled = true;
                    }
                } else {
                    end.min = todayStr;
                }
            });

            // Modal açılış kapanışında formu sıfırla
            modalEl.addEventListener('show.bs.modal',   resetModalForm);
            modalEl.addEventListener('hidden.bs.modal', resetModalForm);

        })();
</script>


</body>
</html>
