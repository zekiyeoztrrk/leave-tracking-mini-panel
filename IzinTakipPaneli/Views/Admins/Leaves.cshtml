@{
    ViewData["Title"] = "İzinler";
    var depts = (IEnumerable<IzinTakipPaneli.Models.Department>)ViewBag.Departments;
}
<link rel="stylesheet"
      href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">

<h4 class="mb-3">İzinler</h4>

<!-- filtreler -->
<div class="row g-2 mb-3 w-100">
    <div class="col-12 col-sm-6 col-md">
        <input id="fltName" class="form-control form-control-sm" placeholder="Ad Soyad">
    </div>

    <div class="col-12 col-sm-6 col-md">
        <select id="fltDept" class="form-select form-select-sm">
            <option value="">Tüm Departmanlar</option>
            @foreach (var d in depts)
            {
                <option value="@d.DepartmentID">@d.DepartmentName</option>
            }
        </select>
    </div>

    <div class="col-12 col-sm-6 col-md">
        <div class="input-group input-group-sm">
            <span class="input-group-text">Başlangıç T.</span>
            <input id="fltFrom" type="date" class="form-control">
        </div>
    </div>

    <div class="col-12 col-sm-6 col-md">
        <div class="input-group input-group-sm">
            <span class="input-group-text">Bitiş T.</span>
            <input id="fltTo" type="date" class="form-control">
        </div>
    </div>

    <div class="col-12 col-sm-6 col-md-auto">
        <button id="btnFilter" class="btn btn-outline-primary btn-sm w-100">Uygula</button>
    </div>
</div>

<!-- tablo -->
<div class="table-responsive">
    <table id="leaveTable" class="table table-sm table-striped align-middle" style="width:100%">
        <thead>
        <tr>
            <th>Ad Soyad</th><th>Departman</th><th>İzin Türü</th>
            <th>Başlangıç</th><th>Bitiş</th><th>İş Günü</th>
        </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<!-- Aksiyon butonları -->
<button class="btn btn-primary mt-4 me-2"
        data-bs-toggle="modal" data-bs-target="#typeModal">
    <i class="bi bi-plus-circle me-1"></i> Yeni İzin Türü
</button>

<button class="btn btn-primary mt-4"
        data-bs-toggle="modal" data-bs-target="#limitModal">
    Yıllık İzin Gününü Değiştir
</button>

<!-- İzin türü modalı -->
<div class="modal fade" id="typeModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog">
  <div class="modal-content">
     <div class="modal-header header-blue">
        <h5 class="modal-title">Yeni İzin Türü</h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
     </div>

     <form id="typeForm" asp-action="AddLeaveType" method="post">
                @Html.AntiForgeryToken()
         <div class="modal-body">
             <label class="form-label">İzin Türü Adı</label>
             <input id="typeName" name="name" class="form-control" required>
             <div id="typeMsg" class="small mt-1"></div>
         </div>
         <div class="modal-footer">
             <button class="btn btn-primary" type="submit" disabled>Kaydet</button>
         </div>
     </form>
  </div>
 </div>
</div>

<!-- Yıllık limit modalı -->
<div class="modal fade" id="limitModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog"><div class="modal-content">
  <div class="modal-header header-blue">
     <h5 class="modal-title">Yıllık İzin Gününü Ayarla</h5>
     <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
  </div>
  <form id="limitForm" asp-action="SetAnnualLimit" method="post">
                @Html.AntiForgeryToken()
     <div class="modal-body">
        <input name="days" type="number" min="1" class="form-control" required>
     </div>
     <div class="modal-footer">
        <button class="btn btn-primary">Kaydet</button>
     </div>
  </form>
 </div></div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        $(function () {

            /* tablo başlangıç, izin listesi*/
            const table = $('#leaveTable').DataTable({
                ajax: {
                    url: '@Url.Action("LeavesData")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'employee' },
                    { data: 'dept' },
                    { data: 'type' },
                    { data: 'start' },
                    { data: 'end' },
                    { data: 'days' }
                ],
                pageLength: 10,
                lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, 'Hepsi']],
                language: {
                    lengthMenu:  '_MENU_ kayıt',
                    search:      'Ara:',
                    info:        '_TOTAL_ kayıttan _START_-_END_'
                },
                dom: 'Bfrtip',
                buttons: [
                    'pageLength',
                    { extend: 'excel', className: 'btn btn-secondary btn-sm' },
                    {
                        extend: 'pdf',
                        className: 'btn btn-secondary btn-sm',
                        exportOptions: { columns: [0, 1, 2, 3, 4, 5] }
                    },
                    { extend: 'print', className: 'btn btn-secondary btn-sm' }
                ]
            });

            /* filtreler */
            $('#btnFilter').on('click', () => {
                let from = $('#fltFrom').val();
                let to   = $('#fltTo').val();

                // Tek tarih girildiyse diğerine kopyala
                if (from && !to) to = from;
                if (to   && !from) from = to;

                const u = '@Url.Action("LeavesData")'
                        + '?name='   + encodeURIComponent($('#fltName').val())
                        + '&dept='   + $('#fltDept').val()
                        + '&dateFrom=' + (from ?? '')
                        + '&dateTo='   + (to   ?? '');

                table.ajax.url(u).load();
            });

            /* yıllık limit modalı değer kaydet */
            $('#limitForm').submit(function (e) {
                e.preventDefault();
                const btn = $(this).find('button').prop('disabled', true);

                fetch('@Url.Action("SetAnnualLimit")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: $(this).serialize()
                })
                .then(() => $('#limitModal').modal('hide'))
                .finally(() => btn.prop('disabled', false));
            });

            /* yeni izin türü */
            // Girilen metni Title-Case’e çevir; butonu aktif et
            $('#typeName').on('input', function () {
                this.value = this.value.toLowerCase()
                                        .replace(/(?:^|\s)\S/g, c => c.toUpperCase());
                $('#typeForm button').prop('disabled', !this.value.trim());
            });

            // Modal kapanınca formu sıfırla
            $('#typeModal').on('hidden.bs.modal', () => {
                $('#typeForm')[0].reset();
                $('#typeMsg').text('');
                $('#typeForm button').prop('disabled', true);
            });

            // Kaydet 
            $('#typeForm').submit(function (e) {
                e.preventDefault();
                const btn = $(this).find('button').prop('disabled', true);

                fetch('@Url.Action("AddLeaveType")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: $(this).serialize()
                })
                .then(r => r.json())
                .then(j => {
                    if (j.ok) {
                        $('#typeModal').modal('hide');
                        table.ajax.reload(null, false); // tabloyu yenile
                    } else {
                        $('#typeMsg').text(j.message).addClass('text-danger');
                        btn.prop('disabled', false);
                    }
                })
                .catch(() => {
                    $('#typeMsg').text('Hata oluştu.').addClass('text-danger');
                    btn.prop('disabled', false);
                });
            });

        });
    </script>
}
