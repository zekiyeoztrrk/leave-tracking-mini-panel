@{
    ViewData["Title"] = "İzinler";
    var depts = (IEnumerable<IzinTakipPaneli.Models.Department>)ViewBag.Departments;
}
<link rel="stylesheet"
      href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h4 class="mb-3">İzinler</h4>

<!-- filtreler -->
<div class="row g-2 mb-3 w-100">
    <div class="col-12 col-sm-6 col-md">
        <input id="fltName" class="form-control form-control-sm" placeholder="Ad Soyad">
    </div>

    <div class="col-12 col-sm-6 col-md">
        <select id="fltDept" class="form-select form-select-sm">
            <option value="">Tüm Departmanlar</option>
            @foreach (var d in depts)
            {
                <option value="@d.DepartmentID">@d.DepartmentName</option>
            }
        </select>
    </div>

    <div class="col-12 col-sm-6 col-md">
        <div class="input-group input-group-sm">
            <span class="input-group-text">Başlangıç T.</span>
            <input id="fltFrom" type="date" class="form-control">
        </div>
    </div>

    <div class="col-12 col-sm-6 col-md">
        <div class="input-group input-group-sm">
            <span class="input-group-text">Bitiş T.</span>
            <input id="fltTo" type="date" class="form-control">
        </div>
    </div>

    <div class="col-12 col-sm-6 col-md-auto">
        <button id="btnFilter" class="btn btn-outline-primary btn-sm w-100">Uygula</button>
    </div>
</div>

<!-- tablo -->
<div class="table-responsive">
    <table id="leaveTable" class="table table-sm table-striped align-middle" style="width:100%">
        <thead>
        <tr>
            <th>Ad Soyad</th><th>Departman</th><th>İzin Türü</th>
            <th>Başlangıç</th><th>Bitiş</th><th>İş Günü</th>
        </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<!-- Aksiyon butonları -->
<button class="btn btn-primary mt-4 me-2"
        data-bs-toggle="modal" data-bs-target="#typeModal">
    <i class="bi bi-plus-circle me-1"></i> Yeni İzin Türü
</button>

<button class="btn btn-primary mt-4"
        data-bs-toggle="modal" data-bs-target="#limitModal">
    Yıllık İzin Gününü Değiştir
</button>

<!-- İzin türü modalı -->
<div class="modal fade" id="typeModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog">
  <div class="modal-content">
     <div class="modal-header header-blue">
        <h5 class="modal-title">Yeni İzin Türü</h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
     </div>

     <form id="typeForm" asp-action="AddLeaveType" method="post">
                @Html.AntiForgeryToken()
         <div class="modal-body">
             <label class="form-label">İzin Türü Adı</label>
             <input id="typeName" name="name" class="form-control" required>
             <div id="typeMsg" class="small mt-1"></div>
         </div>
         <div class="modal-footer">
             <button class="btn btn-primary" type="submit" disabled>Kaydet</button>
         </div>
     </form>
  </div>
 </div>
</div>

<!-- Yıllık limit modalı -->
<div class="modal fade" id="limitModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog"><div class="modal-content">
  <div class="modal-header header-blue">
     <h5 class="modal-title">Yıllık İzin Gününü Ayarla</h5>
     <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
  </div>
  <form id="limitForm" asp-action="SetAnnualLimit" method="post">
                @Html.AntiForgeryToken()
     <div class="modal-body">
        <input name="days" type="number" min="1" class="form-control" required>
     </div>
     <div class="modal-footer">
        <button class="btn btn-primary">Kaydet</button>
     </div>
  </form>
 </div></div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        $(function () {

            // overlay/ backdrop temizleyici (Bootstrap + Swal kalanı varsa)
            function cleanupOverlays() {
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                document.querySelectorAll('.swal2-container').forEach(el => el.remove());
                document.body.classList.remove('modal-open');
            }

            /* tablo başlangıç izin listesi */
            const table = $('#leaveTable').DataTable({
                ajax: {
                    url: '@Url.Action("LeavesData")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'employee' },
                    { data: 'dept' },
                    { data: 'type' },
                    { data: 'start' },
                    { data: 'end' },
                    { data: 'days' }
                ],
                pageLength: 10,
                lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, 'Hepsi']],
                language: {
                    lengthMenu:'_MENU_ kayıt',
                    search:'Ara:',
                    info: '_TOTAL_ kayıttan _START_-_END_'
                },
                dom: 'Bfrtip',
                buttons: [
                    'pageLength',
                    { extend: 'excel', className: 'btn btn-secondary btn-sm' },
                    {
                        extend: 'pdf',
                        className: 'btn btn-secondary btn-sm',
                        exportOptions: { columns: [0, 1, 2, 3, 4, 5] }
                    },
                    { extend: 'print', className: 'btn btn-secondary btn-sm' }
                ]
            });

            /* filtreler */
            $('#btnFilter').on('click', () => {
                let from = $('#fltFrom').val();
                let to   = $('#fltTo').val();

                if (from && !to) to = from;
                if (to && !from) from = to;

                const u = '@Url.Action("LeavesData")'
                        + '?name='   + encodeURIComponent($('#fltName').val())
                        + '&dept='   + $('#fltDept').val()
                        + '&dateFrom=' + (from ?? '')
                        + '&dateTo='   + (to   ?? '');

                table.ajax.url(u).load();
            });

            /* yıllık limit modalı değer kaydet */
            $('#limitForm').submit(async function (e) {
                e.preventDefault();
                const btn = $(this).find('button').prop('disabled', true);
                const body = new URLSearchParams(new FormData(this));
                try {
                    const res = await fetch($(this).attr('action'), {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString(),
                        credentials: 'same-origin'
                    });

                    if (res.redirected) throw new Error('Oturum yönlendirmesi, tekrar giriş gerekebilir.');
                    if (!res.ok) {
                        const text = await res.text();
                        throw new Error('Sunucudan beklenmeyen yanıt: ' + text);
                    }

                    await Swal.fire({
                        icon: 'success',
                        title: 'Başarılı',
                        text: 'Yıllık izin limiti güncellendi.',
                        confirmButtonText: 'Tamam',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    });

                    cleanupOverlays();

                    const limitModalEl = document.getElementById('limitModal');
                    const limitModal = bootstrap.Modal.getInstance(limitModalEl) || new bootstrap.Modal(limitModalEl);
                    limitModal.hide();
                } catch (err) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata',
                        text: 'Yıllık izin limiti güncellenemedi. ' + err.message,
                        confirmButtonText: 'Tamam'
                    });
                    console.error('SetAnnualLimit error:', err);
                    cleanupOverlays();
                } finally {
                    btn.prop('disabled', false);
                }
            });

            // limit modal kapanınca sıfırla
            $('#limitModal').on('hidden.bs.modal', () => {
                $('#limitForm')[0].reset();
            });

            /* yeni izin türü input kontrolü */
            $('#typeName').on('input', function () {
                this.value = this.value.toLowerCase()
                                        .replace(/(?:^|\s)\S/g, c => c.toUpperCase());
                $('#typeForm button').prop('disabled', !this.value.trim());
                $('#typeMsg').text('').removeClass('text-danger');
            });

            $('#typeModal').on('hidden.bs.modal', () => {
                $('#typeForm')[0].reset();
                $('#typeMsg').text('').removeClass('text-danger');
                $('#typeForm button').prop('disabled', true);
            });

            /* yeni izin türü */
            $('#typeForm').submit(async function (e) {
                e.preventDefault();
                const btn = $(this).find('button').prop('disabled', true);
                const body = new URLSearchParams(new FormData(this));
                const actionUrl = $(this).attr('action');

                try {
                    const res = await fetch(actionUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString(),
                        credentials: 'same-origin'
                    });

                    if (res.redirected) throw new Error('Oturum yönlendirmesi oldu.');
                    if (!res.ok) {
                        const text = await res.text();
                        throw new Error('HTTP ' + res.status + ' - ' + text);
                    }

                    let j;
                    const contentType = res.headers.get('Content-Type') || '';
                    if (contentType.includes('application/json')) {
                        j = await res.json();
                    } else {
                        throw new Error('Beklenen JSON dönmedi.');
                    }

                    if (j.ok) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Başarılı',
                            text: 'Yeni izin türü eklendi.',
                            confirmButtonText: 'Tamam',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });

                        cleanupOverlays();

                        const typeModalEl = document.getElementById('typeModal');
                        const typeModal = bootstrap.Modal.getInstance(typeModalEl) || new bootstrap.Modal(typeModalEl);
                        typeModal.hide();

                        table.ajax.reload(null, false);

                        $('#typeMsg').text('').removeClass('text-danger');
                        $('#typeForm')[0].reset();
                        $('#typeForm button').prop('disabled', true);
                    } else {
                        $('#typeMsg').text(j.message || 'Bir hata oluştu.').addClass('text-danger');
                        btn.prop('disabled', false);
                    }
                } catch (err) {
                    $('#typeMsg').text('Hata: ' + err.message).addClass('text-danger');
                    btn.prop('disabled', false);
                    console.error('AddLeaveType error:', err);
                    cleanupOverlays();
                }
            });

        });
    </script>
}
