@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "İzin Takip | Admin";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <!--  İkon  -->
    <link rel="stylesheet"href="https://unpkg.com/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />


    <link rel="stylesheet" href="~/css/user.css"  asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>

<header class="admin-header d-flex align-items-center px-3">
    <!-- burger -->
    <button id="sidebarToggle" class="btn p-0 me-3">
        <i class="bi bi-list fs-3 text-white"></i>
    </button>

    <!-- başlık -->
    <span class="fw-semibold text-white flex-grow-1">İzin Takip • Admin Paneli</span>

    <!-- logout -->
    <a class="btn btn-logout btn-sm" asp-controller="Login" asp-action="Logout">Çıkış Yap</a>
</header>

<!-- sidebar -->
<aside id="sidebar" class="admin-sidebar">
    <nav class="nav flex-column">
        <a class="nav-link" asp-controller="Admins" asp-action="Index">
            <i class="bi bi-house-door me-2"></i> Anasayfa
        </a>
        <a class="nav-link" asp-controller="Admins" asp-action="Employees">
            <i class="bi bi-people me-2"></i> Çalışanlar
        </a>
        <a class="nav-link" asp-controller="Admins" asp-action="Leaves">
            <i class="bi bi-calendar-check me-2"></i> İzinler
        </a>
        <a class="nav-link" asp-controller="Admins" asp-action="Departments">
            <i class="bi bi-building me-2"></i> Departmanlar
        </a>
    </nav>
</aside>

<!-- content -->
<main id="adminMain" class="admin-content container-fluid py-4">
        @RenderBody()
</main>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    @RenderSection("Scripts", required: false)

<script>
/* Ekran genişliğine göre farklı sınıf toggle eder */
const burger = document.getElementById('sidebarToggle');
burger.addEventListener('click', () => {
    const bpLg = window.matchMedia('(min-width:992px)').matches;
    document.body.classList.toggle(bpLg ? 'sidebar-collapsed' : 'sidebar-open');
});
</script>
</body>
</html>
